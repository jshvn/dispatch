{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "rules": { "preset": "none" } },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "asNeeded" } },
  "files": {
    "includes": [
      "schedules/**",
      "src/**",
      "test/**",
      "vitest.config.ts",
      "biome.json",
      "package.json"
    ]
  }
}
